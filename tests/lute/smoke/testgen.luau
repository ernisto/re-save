-- Writes tests/lute/smoke/tests: one spec per function, a test per case of
-- tests/lute/smoke/conditions. The specs are git-ignored; what each case must
-- do lives in tests/lute/smoke/snapshots.json, the only committed output.
-- usage:
--   lute run tests/lute/smoke/testgen.luau          write the specs (before lute test)
--   lute run tests/lute/smoke/testgen.luau update   also rerun every case into snapshots.json
--                                                   (after changing a condition tree, or what the library does)
local fs = require '@lute/fs'
local process = require '@lute/process'

local cases = require './cases'
local conditions = require './conditions'
local mock = require '../mock'
local snapshots = require './snapshots'
local snippet = require './snippet'

local here = (debug.info(1, 's') or ''):gsub('^@', ''):gsub('\\', '/')
local folder = `{here:match '^(.*)/[^/]+$'}/tests`

local function writefile(path: string, text: string)
	local handle = fs.open(path, 'w+')
	fs.write(handle, text)
	fs.close(handle)
end

-- a [==[long string]==] that keeps the text as it reads
local function lit(text: string): string
	local eq = ''
	while text:find(`]{eq}]`, 1, true) do
		eq ..= '='
	end

	local lead = if text:sub(1, 1) == '\n' then '\n' else ''
	return `[{eq}[{lead}{text}]{eq}]`
end

local function formatcase(fnname: string, case): string
	local name = if case.key == '' then '(no conditions)' else case.key
	local ran = if case.ran == case.code then 'code' else lit(case.ran)

	return table.concat({
		`\ts:case({lit(name)}, function(t)`,
		`\t\tlocal code = {lit(case.code)}`,
		`\t\tlocal run = snippet.run('{fnname}', code, {ran})`,
		`\t\tt.eq(snippet.signature(run), snapshots.get('{fnname}', {lit(case.key)}))`,
		'\tend)',
	}, '\n')
end

local function formatspec(fnname: string, list): string
	local tests = {}
	for _, case in list do
		table.insert(tests, formatcase(fnname, case))
	end

	return table.concat({
		'-- Generated by tests/lute/smoke/testgen.luau from tests/lute/smoke/conditions. Do not edit: regenerate instead.',
		`-- Runs every case of {fnname} and compares what it did with tests/lute/smoke/snapshots.json.`,
		"local snippet = require '../snippet'",
		"local snapshots = require '../snapshots'",
		"local test = require '@std/test'",
		'',
		`test.suite('smoke {fnname}', function(s)`,
		table.concat(tests, '\n\n'),
		'end)',
		'',
	}, '\n')
end

-- every case of one function, sorted by key
local function sortedcases(spec)
	local list = cases.cases(spec)
	table.sort(list, function(a, b)
		return a.key < b.key
	end)
	return list
end

local function generate(update: boolean)
	if not fs.exists(folder) then fs.mkdir(folder) end
	local results = {}
	local total = 0

	for _, spec in conditions do
		local list = sortedcases(spec)
		writefile(`{folder}/{spec.name}.spec.luau`, formatspec(spec.name, list))
		total += #list

		if update then
			results[spec.name] = {}
			for _, case in list do
				results[spec.name][case.key] = snippet.signature(snippet.run(spec.name, case.code, case.ran))
			end
		end
	end

	print(`wrote {folder} ({#conditions} functions, {total} cases)`)
	if update then print(`wrote {snapshots.write(results)}`) end
end

-- the library's background sync loop keeps lute running: stop it even when this fails
local ok, err = pcall(generate, process.args[2] == 'update')
mock.close()
if not ok then error(err, 0) end
